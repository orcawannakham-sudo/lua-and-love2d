#!/bin/bash
set -e

# =========================
# OPTIONS
# =========================

CLEAR_CACHE=false

if [[ "$1" == "-c" || "$1" == "--clear-cache" ]]; then
    CLEAR_CACHE=true
fi

# =========================
# PROMPTS
# =========================

read -p "📱 App Name [default: My Love Game]: " APP_NAME
APP_NAME=${APP_NAME:-"My Love Game"}

read -p "📦 Package Name [default: com.example.mygame]: " PKG_NAME
PKG_NAME=${PKG_NAME:-"com.example.mygame"}

if [ "$CLEAR_CACHE" = false ]; then
    read -p "🧹 Clear Gradle cache before build? (y/N): " WIPE

    if [[ "$WIPE" =~ ^[Yy]$ ]]; then
        CLEAR_CACHE=true
    fi
fi

# =========================
# CHECK PACKAGE NAME
# =========================

if [[ ! "$PKG_NAME" =~ ^[a-zA-Z_][a-zA-Z0-9_]*(\.[a-zA-Z_][a-zA-Z0-9_]*)+$ ]]; then
    echo "❌ Invalid package name: $PKG_NAME"
    echo "Example: com.orca.mygame"
    exit 1
fi

echo
echo "📱 App Name : $APP_NAME"
echo "📦 Package  : $PKG_NAME"
echo

# =========================
# 1. DOWNLOAD LÖVE ANDROID
# =========================

if [ ! -d "love-android" ]; then
    echo "📥 Downloading LÖVE Android template..."
    git clone --depth 1 --recursive \
        https://github.com/love2d/love-android.git
fi

# =========================
# 2. CLEAR CACHE
# =========================

if [ "$CLEAR_CACHE" = true ]; then
    echo "🧹 Wiping Gradle caches and build directories..."

    rm -rf love-android/app/build
    rm -rf love-android/.gradle
    rm -rf ~/.gradle/caches/transforms-*

    cd love-android

    ./gradlew --stop &>/dev/null || true
    ./gradlew clean --quiet || true

    cd ..
fi

# =========================
# 3. UPDATE MANIFEST
# =========================

echo "⚙️ Updating Android manifests..."

find love-android -name "AndroidManifest.xml" -type f | while read -r MANIFEST; do

    # package=""
    sed -i -E \
        "s/package=['\"][^'\"]+['\"]/package=\"${PKG_NAME}\"/g" \
        "$MANIFEST"

    # android:label=""
    sed -i -E \
        "s/android:label=['\"][^'\"]+['\"]/android:label=\"${APP_NAME}\"/g" \
        "$MANIFEST"

done

# =========================
# 4. UPDATE GRADLE
# =========================

echo "⚙️ Updating Gradle package..."

find love-android -type f \
    \( -name "*.gradle" -o -name "*.gradle.kts" \) \
    | while read -r GRADLE_FILE; do

    # applicationId "old.package"
    sed -i -E \
        "s/applicationId[[:space:]]+[\"'][^\"']+[\"']/applicationId \"${PKG_NAME}\"/g" \
        "$GRADLE_FILE"

    # applicationId = "old.package"
    sed -i -E \
        "s/applicationId[[:space:]]*=[[:space:]]*[\"'][^\"']+[\"']/applicationId = \"${PKG_NAME}\"/g" \
        "$GRADLE_FILE"

    # namespace "old.package"
    sed -i -E \
        "s/namespace[[:space:]]+[\"'][^\"']+[\"']/namespace \"${PKG_NAME}\"/g" \
        "$GRADLE_FILE"

    # namespace = "old.package"
    sed -i -E \
        "s/namespace[[:space:]]*=[[:space:]]*[\"'][^\"']+[\"']/namespace = \"${PKG_NAME}\"/g" \
        "$GRADLE_FILE"

done

# =========================
# 5. SHOW CONFIG
# =========================

echo
echo "🔎 Package configuration:"
grep -RniE \
    "applicationId|namespace|package=" \
    love-android/app/src \
    love-android/app/*.gradle \
    love-android/*.gradle \
    2>/dev/null || true

echo

# =========================
# 6. CREATE GAME.LOVE
# =========================

echo "📦 Creating game.love..."

rm -f game.love game.apk game-signed.apk

zip -q -r game.love . \
    -x ".git/*" \
    -x "love-android/*" \
    -x "game.love" \
    -x "game.apk" \
    -x "game-signed.apk*" \
    -x "game.keystore"

mkdir -p love-android/app/src/embed/assets

cp game.love \
    love-android/app/src/embed/assets/game.love

# =========================
# 7. BUILD APK
# =========================

echo "🔨 Compiling APK..."

cd love-android

chmod +x gradlew

./gradlew \
    --quiet \
    --no-daemon \
    assembleEmbedNoRecordRelease

cd ..

# =========================
# 8. FIND APK
# =========================

APK=$(find love-android/app/build/outputs \
    -type f \
    -name "*.apk" \
    | head -n 1)

if [ -z "$APK" ]; then
    echo "❌ APK was not created!"
    exit 1
fi

cp "$APK" game.apk

echo "📦 APK created: game.apk"

# =========================
# 9. CREATE KEYSTORE
# =========================

if [ ! -f game.keystore ]; then

    echo "🔑 Creating release keystore..."

    keytool -genkeypair -v \
        -keystore game.keystore \
        -alias game \
        -keyalg RSA \
        -keysize 2048 \
        -validity 10000 \
        -storepass android \
        -keypass android \
        -dname "CN=Game,O=Game,C=US" \
        &>/dev/null

fi

# =========================
# 10. SIGN APK
# =========================

echo "🔏 Signing APK..."

APKSIGNER="$HOME/android-sdk/build-tools/36.0.0/apksigner"

if [ ! -f "$APKSIGNER" ]; then
    echo "❌ apksigner not found:"
    echo "$APKSIGNER"
    exit 1
fi

"$APKSIGNER" sign \
    --ks game.keystore \
    --ks-pass pass:android \
    --key-pass pass:android \
    --out game-signed.apk \
    game.apk

mv game-signed.apk game.apk

# =========================
# 11. VERIFY
# =========================

echo "🔍 Verifying APK..."

"$APKSIGNER" verify --verbose game.apk

echo
echo "================================"
echo "✅ BUILD SUCCESS!"
echo "================================"
echo "📱 App Name : $APP_NAME"
echo "📦 Package  : $PKG_NAME"
echo "📄 APK      : game.apk"
echo "================================"
