#!/bin/bash
set -e

echo "🔥 LÖVE APK compiler setup"

# Interactive Prompts
read -p "📱 Enter App Name (default: My Love Game): " APP_NAME
APP_NAME=${APP_NAME:-"My Love Game"}

read -p "📦 Enter Package Name (e.g., com.example.mygame): " PKG_NAME
PKG_NAME=${PKG_NAME:-"com.example.mygame"}

echo ""
echo "Building '$APP_NAME' [$PKG_NAME]..."
echo ""

# Download LÖVE Android source if missing
if [ ! -d love-android ]; then
    echo "📥 Downloading LÖVE Android..."
    git clone --depth 1 --recursive https://github.com/love2d/love-android.git
fi

# Set Custom App Name and Package Name in Android project
STRINGS_XML="love-android/app/src/main/res/values/strings.xml"
APP_GRADLE="love-android/app/build.gradle"

if [ -f "$STRINGS_XML" ]; then
    sed -i "s/<string name=\"app_name\">.*<\/string>/<string name=\"app_name\">${APP_NAME}<\/string>/" "$STRINGS_XML"
fi

if [ -f "$APP_GRADLE" ]; then
    sed -i "s/applicationId \".*\"/applicationId \"${PKG_NAME}\"/" "$APP_GRADLE"
fi

# Package THIS repository as game.love
echo "📦 Packaging game..."
rm -f game.love game.apk game-signed.apk

zip -r game.love . \
    -x ".git/*" \
    -x "love-android/*" \
    -x "game.love" \
    -x "game.apk" \
    -x "game-signed.apk*" \
    -x "game.keystore"

# Put game into Android project
mkdir -p love-android/app/src/embed/assets
cp game.love love-android/app/src/embed/assets/game.love

# Build
echo "🔨 Compiling APK..."
cd love-android
chmod +x gradlew
./gradlew --no-daemon assembleEmbedNoRecordRelease

# Find APK
APK=$(find app/build/outputs -type f -name "*.apk" | head -n 1)

if [ -z "$APK" ]; then
    echo "❌ Build finished but APK wasn't found"
    exit 1
fi

cd ..
cp "love-android/$APK" ./game.apk

# Generate keystore ONLY if it doesn't exist
if [ ! -f game.keystore ]; then
    echo "🔑 Generating keystore..."
    keytool -genkeypair -v \
        -keystore game.keystore \
        -alias game \
        -keyalg RSA \
        -keysize 2048 \
        -validity 10000 \
        -storepass android \
        -keypass android \
        -dname "CN=${APP_NAME},O=Game,C=US"
fi

echo "🔏 Signing APK..."
"$HOME/android-sdk/build-tools/36.0.0/apksigner" sign \
    --ks game.keystore \
    --ks-pass pass:android \
    --key-pass pass:android \
    --out game-signed.apk \
    game.apk

mv game-signed.apk game.apk

echo ""
echo "================================"
echo "🔥 APK READY!"
echo "📱 App: $APP_NAME"
echo "📦 ID:  $PKG_NAME"
echo "📦 Output: game.apk"
echo "================================"

